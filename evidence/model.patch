++++func testTokenManager() *token.Manager {
++++	return &token.Manager{
++++		PrivateKeyHMAC:              "worker-generation-test-hmac-secret",
++++		WorkerAuthTokenDuration:     time.Hour,
++++		WorkerRegisterTokenDuration: time.Hour,
