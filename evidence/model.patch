+++++++
+++++++	for i := int64(1); i <= totalLogs; i++ {
+++++++		err := engine.client.Exec(
+++++++			"INSERT INTO logs (id, build_id, repo_id, service_id, step_id, data, created_at) VALUES (?, 1, 1, ?, ?, ?, ?)",
+++++++			i, i+1000, i, []byte("old"), cutoffTime-i,
+++++++		).Error
