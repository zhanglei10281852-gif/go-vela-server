+// pgify mirrors the gorm postgres dialector rewrite of "?" placeholders into
+// "$1, $2, ..." so expectations match the exact text sent to the driver.
+func pgify(query string) string {
+	var b strings.Builder
+
+	n := 0
+
+	for _, r := range query {
+		if r == '?' {
+			n++
+			fmt.Fprintf(&b, "$%d", n)
+		} else {
+			b.WriteRune(r)
+		}
+	}
+
+	return b.String()
+}
