+++	token := &WorkerRegisterToken{
+++		ID:        sql.NullInt64{Int64: r.GetID(), Valid: true},
+++		TokenID:   sql.NullString{String: r.GetTokenID(), Valid: true},
+++		Hostname:  sql.NullString{String: r.GetHostname(), Valid: true},
